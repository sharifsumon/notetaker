{
  "name": "@notetaker/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main-dev.ts",
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main-worker.ts",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/scripts/grant-admin.ts",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@notetaker/shared": "workspace:*",
    "bullmq": "^5.61.0",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "pino": "^9.13.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
