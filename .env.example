# =============================================================================
# Meeting Notetaker — environment configuration
# Copy to .env for local development. NEVER commit real secrets.
# The server validates this on startup and lists every problem it finds.
# Values marked [required] must be set; production adds stricter checks (see README).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=4000                            # API port
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent
LOG_FORMAT=json                      # json | pretty (pretty needs dev dependencies)
TRUST_PROXY=0                        # number of reverse-proxy hops in front of the API (1 behind nginx/LB)
PUBLIC_URL=http://localhost:5173     # [required] public origin of the web app; the API is served at PUBLIC_URL/api
                                     # OAuth redirect URIs: PUBLIC_URL/api/v1/auth/{google|microsoft}/callback
                                     #                      PUBLIC_URL/api/v1/calendar-connections/{google_calendar|microsoft_calendar}/callback
WEBHOOK_PUBLIC_URL=                  # base URL the meeting-bot provider uses to reach webhooks (defaults to PUBLIC_URL)
ALLOWED_ORIGINS=                     # extra origins allowed for credentialed CORS (comma-separated). Empty = same-origin only
DEFAULT_TIMEZONE=UTC                 # timezone for new accounts (users can change it)

# ---- Database / queue -------------------------------------------------------
# Runtime role: a LOGIN role that is a member of `notetaker_app` (NOT the table owner,
# NOT a superuser) so PostgreSQL row-level security is enforced.
DATABASE_URL=postgres://notetaker_app_user:app_dev_password@localhost:5432/notetaker   # [required]
# Owner role used only to run migrations.
DATABASE_MIGRATION_URL=postgres://notetaker_owner:owner_dev_password@localhost:5432/notetaker
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379     # BullMQ + rate limiting

# ---- Sessions & encryption --------------------------------------------------
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars   # [required] openssl rand -base64 48
SESSION_TTL_HOURS=168                # absolute session lifetime
SESSION_IDLE_TIMEOUT_HOURS=24        # idle timeout
COOKIE_SECURE=false                  # must be true in production (HTTPS)
# AES-256-GCM keys for OAuth tokens and meeting URLs at rest. Format: keyId:base64(32 bytes),...
# Generate: echo "k1:$(openssl rand -base64 32)". Add a new key + switch ACTIVE to rotate.
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES_KEY_AAAAAAAAAAA=   # [required]
TOKEN_ENCRYPTION_ACTIVE_KEY=k1       # [required]

# ---- Sign-in & calendars (Google / Microsoft) --------------------------------
GOOGLE_CLIENT_ID=                    # Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=                 # Microsoft Entra app registration
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common              # common | organizations | consumers | <tenant id>
AUTH_DEV_LOGIN_ENABLED=true          # local development only — refused in production
CALENDAR_SYNC_INTERVAL_MINUTES=10
CALENDAR_SYNC_PAST_DAYS=14           # history window
CALENDAR_SYNC_FUTURE_DAYS=30         # rolling horizon for upcoming meetings

# ---- Meeting bot provider ---------------------------------------------------
MEETING_BOT_PROVIDER=mock            # mock (development only) | none. Real providers: see docs/PROVIDERS.md
MEETING_BOT_NAME_TEMPLATE="{name}'s Notetaker (recording)"
BOT_JOIN_LEAD_MINUTES=2              # create the bot session this long before the start time
BOT_RECONCILE_GRACE_MINUTES=30       # poll provider state for sessions past their end time
MOCK_BOT_WEBHOOK_SECRET=local-dev-webhook-secret   # required when MEETING_BOT_PROVIDER=mock
MOCK_BOT_STEP_MS=3000                # spacing of simulated mock lifecycle events
WEBHOOK_TOLERANCE_SECONDS=300        # reject webhooks older/newer than this (replay protection)

# ---- Storage -----------------------------------------------------------------
STORAGE_DRIVER=local                 # local (single server; use an encrypted volume) | s3
STORAGE_LOCAL_DIR=./.data/storage
S3_BUCKET=                           # private bucket with Block Public Access enabled
S3_REGION=
S3_ENDPOINT=                         # for MinIO / R2 / other S3-compatible stores
S3_FORCE_PATH_STYLE=false
S3_SSE=AES256                        # AES256 | aws:kms
S3_KMS_KEY_ID=
SIGNED_URL_TTL_SECONDS=60            # lifetime of playback/download signed URLs (S3 only)
RECORDING_MAX_BYTES=1073741824       # 1 GiB
RECORDING_MAX_DURATION_SECONDS=14400 # 4 hours
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Speech-to-text ----------------------------------------------------------
STT_PROVIDER=mock                    # mock (development only) | deepgram | none
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
STT_LANGUAGE=                        # e.g. en, bn. Empty = automatic language detection

# ---- AI summaries & minutes --------------------------------------------------
LLM_PROVIDER=mock                    # mock (development only, extractive) | anthropic | none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CHUNK_CHARS=48000                # transcripts longer than this are summarized in chunks (map-reduce)
LLM_MAX_TRANSCRIPT_CHARS=600000      # maximum transcript size used; longer transcripts are truncated and flagged
MIN_TRANSCRIPT_WORDS=25              # below this, no summary/minutes are generated ("insufficient source")
AUTO_GENERATE_SUMMARY=true           # generate the summary automatically after transcription
AUTO_GENERATE_MINUTES=false          # minutes are generated on first request unless true

# ---- Retention & operations --------------------------------------------------
RETENTION_DAYS=90                    # delete recordings + derived data after N days (0 = keep). Confirm before launch.
METRICS_TOKEN=                       # bearer token for GET /metrics (required to expose metrics in production)
JOB_MAX_ATTEMPTS=5                   # default retry attempts for background jobs
WORKER_METRICS_PORT=                 # optional: worker exposes /metrics and /health on this port
