{
	# Let's Encrypt account email.
	email {$ACME_EMAIL}
}

# Caddy obtains and renews HTTPS certificates automatically.
# DNS A records for DOMAIN and www.DOMAIN must point at this server before first start.
{$DOMAIN} {
	encode gzip
	reverse_proxy web:8080
}

# www → bare domain (the app has one canonical origin; OAuth redirect URIs use it).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
